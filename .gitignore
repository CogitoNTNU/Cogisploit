# Keep GitHub metadata, README assets and actual challenges in the repository.
/*
!/.github/
!/.gitignore
!/LICENSE
!/README.md
!/ctfs/
!/docs/

# Keep the README assets; leave the retired documentation files local.
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/cogisploit-logo.png
!/docs/images/spacer.png
!/docs/images/rounded/
/docs/images/rounded/*
!/docs/images/rounded/aisecuritylearningpaththm.png
!/docs/images/rounded/cogisploitbanner.png
!/docs/images/rounded/matrix.png
!/docs/images/rounded/mirage.png
!/docs/images/rounded/rouge2.png

.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
