# Kopier til .env (samme mappe som docker-compose.yml) og fyll inn ÉN av blokkene.
# docker compose leser .env automatisk. .env er i .gitignore, så nøkkelen havner ikke i git.
# Uten nøkkel svarer Hugin uten språkmodell, og oppgaven kan fortsatt løses.

# --- Idun (standard) — krever NTNUs nett eller VPN ---------------------------
# Personlig nøkkel: send e-post til help@hpc.ntnu.no
NTNU_API_KEY=sk-din-idun-nøkkel
# LLM_BASE_URL og LLM_MODEL trengs ikke for Idun, standardverdiene peker dit:
# LLM_BASE_URL=https://llm.hpc.ntnu.no/v1
# LLM_MODEL=openai/gpt-oss-120b

# --- OpenAI eller en annen OpenAI-kompatibel tjeneste ------------------------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=sk-...

# --- Lokal modell med Ollama på din egen maskin ------------------------------
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=gpt-oss:20b
# LLM_API_KEY=ollama
